# Database (SQLite)
DATABASE_URL=sqlite:///./detectar.db

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Model
MODEL_VERSION=efficientnet-b0-v1
AUDIO_MODEL_PATH=./model/weights/audio_deepfake_v1_fake_braccent_d_codec_equalized/audio_deepfake_v1_best.pth
AUDIO_MODEL_SUMMARY_PATH=./model/weights/audio_deepfake_v1_fake_braccent_d_codec_equalized/summary.json
AUDIO_ASR_ENABLED=true
AUDIO_ASR_MODEL=medium
AUDIO_ASR_LANGUAGE=pt
AUDIO_ASR_DEVICE=auto
AUDIO_ASR_COMPUTE_TYPE=default
AUDIO_ASR_BEAM_SIZE=5
AUDIO_ASR_VAD_FILTER=false
AUDIO_ASR_PREPROCESS_ENABLED=true

# Liveness
LIVENESS_SESSION_SECRET=change-me-generate-with-secrets-token-urlsafe
LIVENESS_SESSION_TTL_SECONDS=120
LIVENESS_ANTI_SPOOF_ENABLED=true
LIVENESS_ANTI_SPOOF_THRESHOLD=0.55
LIVENESS_ONNX_ANTISPOOF_ENABLED=true
LIVENESS_ONNX_ANTISPOOF_DECISION_ENABLED=false
LIVENESS_ONNX_ANTISPOOF_PATH=./model/weights/antispoof_mobilenet_v1_cv/fold_3/antispoof_mobilenet_v1.onnx
LIVENESS_ONNX_ANTISPOOF_METADATA_PATH=./model/weights/antispoof_mobilenet_v1_cv/fold_3/antispoof_mobilenet_v1_metadata.json
LIVENESS_ONNX_ANTISPOOF_AGGREGATION=p75
LIVENESS_ONNX_ANTISPOOF_THRESHOLD=0.65
LIVENESS_ONNX_ANTISPOOF_REVIEW_THRESHOLD=0.50
LIVENESS_ONNX_ANTISPOOF_FRAME_SPIKE_MARGIN=0.12
LIVENESS_ONNX_QUALITY_OVERRIDE_THRESHOLD=0.75
LIVENESS_MOBILE_ONNX_HARD_THRESHOLD=0.75
LIVENESS_FUSION_FACE_BACKGROUND_DELTA=0.34
LIVENESS_FUSION_INTERNAL_MOTION_MAX=0.06
LIVENESS_ONNX_MIN_FACE_WIDTH_RATIO=0.24
LIVENESS_CAPTURE_STORAGE_ENABLED=true
LIVENESS_CAPTURE_STORAGE_PATH=./data/calibration/liveness_captures
