# Database (SQLite)
DATABASE_URL=sqlite:///./detectar.db

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Model
MODEL_VERSION=efficientnet-b0-v1

# Liveness
LIVENESS_SESSION_SECRET=change-me-generate-with-secrets-token-urlsafe
LIVENESS_SESSION_TTL_SECONDS=120
LIVENESS_ANTI_SPOOF_ENABLED=true
LIVENESS_ANTI_SPOOF_THRESHOLD=0.55
LIVENESS_ONNX_ANTISPOOF_ENABLED=true
LIVENESS_ONNX_ANTISPOOF_PATH=./model/weights/antispoof_mobilenet_v1_cv/fold_3/antispoof_mobilenet_v1.onnx
LIVENESS_ONNX_ANTISPOOF_METADATA_PATH=./model/weights/antispoof_mobilenet_v1_cv/fold_3/antispoof_mobilenet_v1_metadata.json
LIVENESS_ONNX_ANTISPOOF_AGGREGATION=p75
LIVENESS_ONNX_ANTISPOOF_THRESHOLD=-1.0
LIVENESS_ONNX_ANTISPOOF_REVIEW_THRESHOLD=0.095
LIVENESS_ONNX_ANTISPOOF_FRAME_SPIKE_MARGIN=0.035
LIVENESS_ONNX_QUALITY_OVERRIDE_THRESHOLD=0.20
LIVENESS_MOBILE_ONNX_HARD_THRESHOLD=0.20
LIVENESS_FUSION_FACE_BACKGROUND_DELTA=0.34
LIVENESS_FUSION_INTERNAL_MOTION_MAX=0.06
LIVENESS_ONNX_MIN_FACE_WIDTH_RATIO=0.24
